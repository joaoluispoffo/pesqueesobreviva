<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Porta HTTP do servidor -->
    <add key="Port" value="8080" />
    <!-- Pasta com os arquivos do frontend (relativa a pasta bin, ou caminho absoluto) -->
    <add key="Root" value="..\www" />
    <!-- true = rotas sem extensao (ex.: /usuarios/1) retornam index.html (React/Vue/Angular) -->
    <add key="SpaFallback" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
